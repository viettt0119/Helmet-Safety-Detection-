# ---------------------------------------------------------------------------
# Helmet Safety Detection — configuration (copy to .env and adjust)
# All variables use the HELMET_ prefix; "__" separates nested sections.
# ---------------------------------------------------------------------------

# General
HELMET_ENVIRONMENT=development          # development | staging | production | test
HELMET_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
HELMET_LOG_JSON=false                   # true => JSON logs (recommended in production)

# Model / inference (paths default to <project>/models, <project>/runs; relative paths are resolved from the CWD)
# HELMET_MODEL__WEIGHTS_PATH=models/helmet_yolov10n_best.pt
# HELMET_MODEL__PRETRAINED_WEIGHTS_PATH=models/yolov10n.pt
HELMET_MODEL__PRETRAINED_WEIGHTS_URL=https://github.com/ultralytics/assets/releases/download/v8.4.0/yolov10n.pt
# HELMET_MODEL__RUNS_DIR=runs
HELMET_MODEL__AUTO_DISCOVER_WEIGHTS=true   # fallback to newest runs/*/weights/best.pt
HELMET_MODEL__DEVICE=auto               # auto | cpu | mps | cuda | cuda:N | 0 | 0,1
HELMET_MODEL__IMAGE_SIZE=640            # multiple of 32
HELMET_MODEL__BASE_CONFIDENCE=0.10      # raw NMS threshold (per-class policy filters afterwards)
HELMET_MODEL__IOU=0.7
HELMET_MODEL__MAX_DETECTIONS=300
HELMET_MODEL__HALF_PRECISION=false      # FP16 on CUDA only

# Compliance policy
HELMET_POLICY__DEFAULT_CONFIDENCE=0.35
HELMET_POLICY__PERSON_CONFIDENCE=0.35
HELMET_POLICY__HELMET_CONFIDENCE=0.35
HELMET_POLICY__HEAD_CONFIDENCE=0.35
HELMET_POLICY__HEAD_REGION_RATIO=0.5    # top part of a person box where the head is searched
HELMET_POLICY__MIN_CONTAINMENT=0.5      # share of the head/helmet box that must be inside it
HELMET_POLICY__COUNT_UNMATCHED_HELMETS=true
HELMET_POLICY__COUNT_UNMATCHED_HEADS=true

# REST API
HELMET_API__HOST=0.0.0.0
HELMET_API__PORT=8000
HELMET_API__WORKERS=1
HELMET_API__MAX_UPLOAD_MB=10
HELMET_API__INFERENCE_TIMEOUT_S=30
HELMET_API__MAX_CONCURRENCY=2
HELMET_API__CORS_ORIGINS=[]             # JSON list, e.g. ["https://dashboard.example.com"]
HELMET_API__JPEG_QUALITY=90

# Training
# HELMET_TRAINING__DATASET_YAML=data/data.yaml
HELMET_TRAINING__EPOCHS=50
HELMET_TRAINING__BATCH=8                # -1 = auto batch
HELMET_TRAINING__WORKERS=4
HELMET_TRAINING__PATIENCE=20
HELMET_TRAINING__SEED=0
HELMET_TRAINING__RUN_NAME=helmet_yolov10n

# Downloads (retry with exponential back-off)
HELMET_DOWNLOAD__TIMEOUT_S=60
HELMET_DOWNLOAD__MAX_ATTEMPTS=4
HELMET_DOWNLOAD__BACKOFF_INITIAL_S=1
HELMET_DOWNLOAD__BACKOFF_MAX_S=20
